# Public URL of the deployed site (used for canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://sirazul263.vercel.app

# Contact form delivery via Resend (https://resend.com). Without a key the form
# shows a "email me directly" fallback instead of pretending to send.
RESEND_API_KEY=
# Address that receives contact-form messages. Defaults to the site email.
CONTACT_TO_EMAIL=
# Verified sender for Resend. On the free tier use onboarding@resend.dev.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: raises the GitHub API rate limit for the live activity module.
GITHUB_TOKEN=
